<?xml version="1.0" ?>
<!--
  urban_city.sdf — Minimal urban environment for VLA navigation benchmark.
  Uses simple geometry primitives styled as buildings, roads, and landmarks.
  Compatible with Gazebo Harmonic (gz-sim).
-->
<sdf version="1.9">
  <world name="urban_city">

    <!-- ── Physics ──────────────────────────────────────────────────────── -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ── Plugins ──────────────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <!-- Sensors plugin without render_engine — camera rendering is not
         needed for Milestone 1 and avoids Ogre assertion crashes on cleanup. -->
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"   name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system"   name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"          name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <!-- ── Lighting ─────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- Ambient skylight -->
    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.55 0.72 0.95 1.0</background>
    </scene>

    <!-- ── Ground plane (asphalt) ───────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Road (lighter strip) ─────────────────────────────────────────── -->
    <model name="road_ns">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>8 100 0.02</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Buildings ────────────────────────────────────────────────────── -->

    <!-- Building A — tall office tower -->
    <model name="building_a">
      <static>true</static>
      <pose>20 -8 10 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 10 20</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10 10 20</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building B — medium apartment block -->
    <model name="building_b">
      <static>true</static>
      <pose>-18 15 6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12 8 12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12 8 12</size></box></geometry>
          <material><ambient>0.72 0.55 0.40 1</ambient><diffuse>0.80 0.62 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building C — short warehouse -->
    <model name="building_c">
      <static>true</static>
      <pose>-12 -15 3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>14 10 6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>14 10 6</size></box></geometry>
          <material><ambient>0.55 0.55 0.50 1</ambient><diffuse>0.60 0.60 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building D — glass-style tower -->
    <model name="building_d">
      <static>true</static>
      <pose>30 5 12.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 8 25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 8 25</size></box></geometry>
          <material><ambient>0.45 0.55 0.65 1</ambient><diffuse>0.5 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building E — residential -->
    <model name="building_e">
      <static>true</static>
      <pose>-30 -5 4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 12 8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10 12 8</size></box></geometry>
          <material><ambient>0.85 0.82 0.75 1</ambient><diffuse>0.90 0.88 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building F — small shop -->
    <model name="building_f">
      <static>true</static>
      <pose>12 25 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6 6 5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6 6 5</size></box></geometry>
          <material><ambient>0.75 0.70 0.55 1</ambient><diffuse>0.80 0.75 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Landmark objects ─────────────────────────────────────────────── -->

    <!-- Red car (east side) — referenced by Task 1 -->
    <model name="red_car">
      <static>true</static>
      <pose>15 10 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4 1.8 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4 1.8 1.0</size></box></geometry>
          <material><ambient>0.85 0.10 0.10 1</ambient><diffuse>0.95 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Blue dumpster (alley) — referenced by Task 5 -->
    <model name="blue_dumpster">
      <static>true</static>
      <pose>8 -12 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2 1.5 1.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2 1.5 1.2</size></box></geometry>
          <material><ambient>0.10 0.20 0.75 1</ambient><diffuse>0.15 0.25 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- White house — referenced by Task 7 -->
    <model name="white_house">
      <static>true</static>
      <pose>-15 8 3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 6 6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8 6 6</size></box></geometry>
          <material><ambient>0.92 0.92 0.90 1</ambient><diffuse>0.97 0.97 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree cluster (decorative cylinders) -->
    <model name="tree_1">
      <static>true</static>
      <pose>5 18 1.5 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 -1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><sphere><radius>1.2</radius></sphere></geometry>
          <material><ambient>0.15 0.55 0.15 1</ambient><diffuse>0.2 0.65 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-8 30 1.5 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 -1 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><sphere><radius>1.4</radius></sphere></geometry>
          <material><ambient>0.12 0.50 0.12 1</ambient><diffuse>0.18 0.60 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Construction barriers — referenced by Task 8 area -->
    <model name="barrier_1">
      <static>true</static>
      <pose>-28 -14 0.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>3 0.3 1.0</size></box></geometry>
          <material><ambient>0.9 0.6 0.0 1</ambient><diffuse>1.0 0.7 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="barrier_2">
      <static>true</static>
      <pose>-32 -8 0.5 0 0 0.7854</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>3 0.3 1.0</size></box></geometry>
          <material><ambient>0.9 0.6 0.0 1</ambient><diffuse>1.0 0.7 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
